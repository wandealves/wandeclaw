# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-seu-token-do-BotFather
# IDs numéricos separados por vírgula (descubra o seu com @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- LLM ---
# Provedores disponíveis: gemini | deepseek | groq
LLM_PROVIDER=gemini
# Provedores usados em cascata se o principal falhar (opcional, separados por vírgula)
LLM_FALLBACK_PROVIDERS=deepseek
# Provedor barato usado pelo SkillRouter (opcional; padrão = LLM_PROVIDER)
ROUTER_PROVIDER=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Timeout por chamada de LLM (ms)
LLM_TIMEOUT_MS=120000

# --- Agente ---
AGENT_NAME=WandeClaw
MAX_ITERATIONS=5
MEMORY_WINDOW_SIZE=20

# --- Diretórios ---
DB_PATH=./data/sandecoclaw.db
TMP_DIR=./tmp
SKILLS_DIR=./.agents/skills
WORKSPACE_DIR=./workspace
