# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-seu-token-do-BotFather
# IDs numéricos separados por vírgula (descubra o seu com @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- LLM ---
# Provedores disponíveis:
#   via API key: gemini | deepseek | groq
#   via CLI (sem API key, usa o login da CLI): claude-code | opencode
LLM_PROVIDER=gemini
# Provedores usados em cascata se o principal falhar (separados por vírgula; use um diferente do principal)
LLM_FALLBACK_PROVIDERS=deepseek
# Provedor barato usado pelo SkillRouter (opcional; padrão = LLM_PROVIDER)
ROUTER_PROVIDER=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Timeout por chamada de LLM (ms)
LLM_TIMEOUT_MS=120000

# --- LLM via CLI (claude-code / opencode) ---
# As CLIs rodam com cwd = WORKSPACE_DIR e usam as próprias ferramentas lá dentro.
CLI_TIMEOUT_MS=300000

# Claude Code (claude -p). Modelo opcional: sonnet | opus | haiku | id completo
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_MODEL=
# Ferramentas nativas liberadas (adicione Bash só se aceitar comandos no seu PC vindos do Telegram)
CLAUDE_CODE_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,WebSearch,WebFetch
# dontAsk = nega o que não estiver na lista acima, sem perguntar
CLAUDE_CODE_PERMISSION_MODE=dontAsk

# OpenCode (opencode run). Modelo no formato provider/model (veja "opencode models")
OPENCODE_COMMAND=opencode
OPENCODE_MODEL=
OPENCODE_AGENT=
# Permissões (allow|deny) por ferramenta; o padrão nega bash e acesso fora do workspace
OPENCODE_PERMISSIONS=bash=deny,external_directory=deny
# true = aprova automaticamente permissões não negadas explicitamente (perigoso)
OPENCODE_AUTO_APPROVE=false

# --- Agente ---
AGENT_NAME=WandeClaw
MAX_ITERATIONS=5
MEMORY_WINDOW_SIZE=20

# --- Diretórios ---
DB_PATH=./data/sandecoclaw.db
TMP_DIR=./tmp
SKILLS_DIR=./.agents/skills
WORKSPACE_DIR=./workspace
# Backups diários do SQLite (quantos manter; 0 desativa)
DB_BACKUP_DIR=./data/backups
DB_BACKUP_KEEP=7

# --- Documentos (PDF/MD) ---
# Tamanho máximo aceito (MB). A Bot API do Telegram limita downloads a 20 MB.
MAX_DOCUMENT_MB=20

# --- Voz: STT (Whisper local) ---
# openai = CLI do openai-whisper (pip install openai-whisper)
# cpp    = whisper.cpp (whisper-cli); WHISPER_MODEL deve ser o caminho do .bin ggml
WHISPER_BACKEND=openai
WHISPER_COMMAND=whisper
WHISPER_MODEL=base
# Vazio = detecção automática do idioma
WHISPER_LANGUAGE=pt
WHISPER_TIMEOUT_MS=60000
FFMPEG_PATH=ffmpeg

# --- Voz: TTS (Edge-TTS) ---
# cli = CLI oficial em Python (pip install edge-tts) — recomendado
# npm = edge-tts-universal (Node puro; a v1.4.0 recebe 403 do serviço desde a troca do token da Microsoft)
TTS_BACKEND=cli
TTS_COMMAND=edge-tts
TTS_VOICE=pt-BR-ThalitaMultilingualNeural
TTS_TIMEOUT_MS=60000
