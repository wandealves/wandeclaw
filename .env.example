# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-seu-token-do-BotFather
# IDs numéricos separados por vírgula (descubra o seu com @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- LLM ---
# Provedores disponíveis: gemini | deepseek | groq
LLM_PROVIDER=gemini
# Provedores usados em cascata se o principal falhar (opcional, separados por vírgula)
LLM_FALLBACK_PROVIDERS=deepseek
# Provedor barato usado pelo SkillRouter (opcional; padrão = LLM_PROVIDER)
ROUTER_PROVIDER=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Timeout por chamada de LLM (ms)
LLM_TIMEOUT_MS=120000

# --- Agente ---
AGENT_NAME=WandeClaw
MAX_ITERATIONS=5
MEMORY_WINDOW_SIZE=20

# --- Diretórios ---
DB_PATH=./data/sandecoclaw.db
TMP_DIR=./tmp
SKILLS_DIR=./.agents/skills
WORKSPACE_DIR=./workspace
# Backups diários do SQLite (quantos manter; 0 desativa)
DB_BACKUP_DIR=./data/backups
DB_BACKUP_KEEP=7

# --- Documentos (PDF/MD) ---
# Tamanho máximo aceito (MB). A Bot API do Telegram limita downloads a 20 MB.
MAX_DOCUMENT_MB=20

# --- Voz: STT (Whisper local) ---
# openai = CLI do openai-whisper (pip install openai-whisper)
# cpp    = whisper.cpp (whisper-cli); WHISPER_MODEL deve ser o caminho do .bin ggml
WHISPER_BACKEND=openai
WHISPER_COMMAND=whisper
WHISPER_MODEL=base
# Vazio = detecção automática do idioma
WHISPER_LANGUAGE=pt
WHISPER_TIMEOUT_MS=60000
FFMPEG_PATH=ffmpeg

# --- Voz: TTS (Edge-TTS) ---
# cli = CLI oficial em Python (pip install edge-tts) — recomendado
# npm = edge-tts-universal (Node puro; a v1.4.0 recebe 403 do serviço desde a troca do token da Microsoft)
TTS_BACKEND=cli
TTS_COMMAND=edge-tts
TTS_VOICE=pt-BR-ThalitaMultilingualNeural
TTS_TIMEOUT_MS=60000
